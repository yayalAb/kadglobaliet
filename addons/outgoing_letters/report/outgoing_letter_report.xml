<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_outgoing_letter" model="ir.actions.report">
        <field name="name">Outgoing Letter</field>
        <field name="model">outgoing.letter</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">outgoing_letters.report_outgoing_letter</field>
        <field name="report_file">outgoing_letters.report_outgoing_letter</field>
        <field name="print_report_name">'Letter - %s' % object.name</field>
        <field name="binding_model_id" eval="False"/>
    </record>

    <template id="outgoing_letter_layout_logo_resize" inherit_id="web.external_layout_standard">
        <xpath expr="//div[contains(@t-attf-class, 'header')]" position="inside">
            <style t-if="is_outgoing_letter">
                .header img.o_company_logo_small,
                .header .o_company_logo,
                .header img,
                div[class*="header"] img {
                    max-height: 110px !important;
                    max-width: 320px !important;
                    height: auto !important;
                    width: auto !important;
                }
            </style>
        </xpath>
    </template>

    <template id="report_outgoing_letter">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="doc_title" t-value="o.title"/>
                <t t-set="doc_number" t-value="o.name"/>
                <t t-set="issue_number" t-value="'1'"/>
                <t t-set="no_watermark" t-value="True"/>
                <t t-set="is_outgoing_letter" t-value="True"/>
                <t t-call="web.external_layout">
                    <style>
                        /* Larger header logo */
                        .header img.o_company_logo_small,
                        .header .o_company_logo,
                        .header img,
                        div[class*="header"] img {
                            max-height: 110px !important;
                            max-width: 320px !important;
                            height: auto !important;
                            width: auto !important;
                        }
                        /* Hide fixed watermark overlay if present in standard layout */
                        div[style*="pointer-events: none"],
                        div[style*="z-index: 9999"],
                        .report-watermark-bg {
                            display: none !important;
                        }
                        .page, .page p, .page div, .page span, .page table, .page td, .page th {
                            font-family: 'Ebrima', 'Nyala', 'Noto Sans Ethiopic', 'Segoe UI', Arial, sans-serif !important;
                        }
                    </style>
                    <div class="page" style="font-family: 'Ebrima', 'Nyala', 'Noto Sans Ethiopic', 'Segoe UI', Arial, sans-serif;">
                        <style>
                            div[style*="pointer-events: none"],
                            div[style*="z-index: 9999"],
                            .report-watermark-bg {
                                display: none !important;
                            }
                            .page, .page p, .page div, .page span, .page table, .page td, .page th {
                                font-family: 'Ebrima', 'Nyala', 'Noto Sans Ethiopic', 'Segoe UI', Arial, sans-serif !important;
                            }
                        </style>
                        <t t-set="comp" t-value="o.company_id or env.company"/>
                        <div style="text-align: right; margin-bottom: 12px;">
                            <strong>REF No:</strong> <span t-field="o.name"/><br/>
                            <strong>Date:</strong> <span t-field="o.date"/>
                        </div>
                        <div t-field="o.content"/>

                        <!-- Approved user signature and company stamp right next to / at end of content -->
                        <div class="clearfix mt-4" style="page-break-inside: avoid; text-align: right; padding-right: 15px;">
                            <div t-if="o.approver_signature"
                                 style="display: inline-block; vertical-align: bottom; margin-right: 20px; text-align: center;">
                                <img t-att-src="image_data_uri(o.approver_signature)"
                                     style="max-height: 85px; max-width: 180px; object-fit: contain; border: 0 !important; outline: none !important; box-shadow: none !important;"
                                     alt="Signature"/>
                                <div t-if="o.approver_name"
                                     style="font-size: 11px; font-weight: 600; color: #222; border-top: 1px dotted #777; padding-top: 3px; margin-top: 3px;">
                                    <span t-out="o.approver_name"/>
                                </div>
                            </div>
                            <div t-if="comp and comp.company_stamp"
                                 style="display: inline-block; vertical-align: bottom;">
                                <img t-att-src="image_data_uri(comp.company_stamp)"
                                     style="max-height: 175px; max-width: 250px; object-fit: contain; border: 0 !important; outline: none !important; box-shadow: none !important;"
                                     alt="Company Stamp"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
