<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add a company-logo watermark behind every report that uses web.external_layout_standard.
         The logo is rendered as a large, centered, semi-transparent overlay on every page. -->
    <template id="report_logo_watermark" inherit_id="web.external_layout_standard">
        <xpath expr="//t[@t-call='web.address_layout']" position="before">
            <t t-set="wm_company" t-value="o.company_id if o and 'company_id' in o else res_company" />
            <div t-if="wm_company and wm_company.logo and not no_watermark"
                 class="report-watermark-bg"
                 style="position: fixed; top: 10%; left: 10%; width: 80%; height: 80%;
                        z-index: 9999; pointer-events: none;
                        text-align: center;">
                <img t-att-src="image_data_uri(wm_company.logo)"
                     style="margin-top: 20%; width: 80%; opacity: 0.08;"
                     alt="" />
            </div>
        </xpath>
    </template>
</odoo>
