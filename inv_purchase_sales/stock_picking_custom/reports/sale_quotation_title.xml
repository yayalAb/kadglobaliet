<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Rename "Quotation #" / "Order #" to "Sales Quotation #" / "Sales Order #" on the
         native Quotation / Order print report, and fill the KAD letterhead's Doc Title box
         (which otherwise falls back to the generic "Document" label). -->
    <template id="report_saleorder_document_quotation_title" inherit_id="sale.report_saleorder_document">
        <xpath expr="//t[@t-set='forced_vat']" position="after">
            <t t-set="doc_title" t-value="'Sales Quotation' if doc.state in ('draft', 'sent') else 'Sales Order'" />
            <t t-set="doc_number" t-value="doc.name" />
            <t t-set="issue_number" t-value="'1'" />
        </xpath>
        <xpath expr="//span[@t-elif=&quot;doc.state in ['draft','sent']&quot;]" position="replace">
            <span t-elif="doc.state in ['draft','sent']">Sales Quotation # </span>
        </xpath>
        <xpath expr="//t[@t-set='layout_document_title']//span[@t-else='']" position="replace">
            <span t-else="">Sales Order # </span>
        </xpath>
    </template>
</odoo>
