<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_delivery_port_tree" model="ir.ui.view">
        <field name="name">delivery.port.tree</field>
        <field name="model">delivery.port</field>
        <field name="arch" type="xml">
            <list string="Delivery Ports">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <record id="view_delivery_port_form" model="ir.ui.view">
        <field name="name">delivery.port.form</field>
        <field name="model">delivery.port</field>
        <field name="arch" type="xml">
            <form string="Delivery Port">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="country_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_delivery_port_search" model="ir.ui.view">
        <field name="name">delivery.port.search</field>
        <field name="model">delivery.port</field>
        <field name="arch" type="xml">
            <search string="Delivery Ports">
                <field name="name"/>
                <field name="code"/>
                <field name="country_id"/>
                <group expand="0" string="Group By">
                    <filter string="Country" name="group_by_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_delivery_port" model="ir.actions.act_window">
        <field name="name">Delivery Ports</field>
        <field name="res_model">delivery.port</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_delivery_port"
        name="Delivery Ports"
        parent="sale.menu_sale_config"
        action="action_delivery_port"
        sequence="35"/>
</odoo>
