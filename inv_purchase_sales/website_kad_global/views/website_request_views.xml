<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_website_request_list" model="ir.ui.view">
        <field name="name">website.request.list</field>
        <field name="model">website.request</field>
        <field name="arch" type="xml">
            <list string="Website Requests" decoration-muted="state == 'cancelled'" decoration-success="state == 'converted'">
                <field name="create_date" string="Submitted On"/>
                <field name="name"/>
                <field name="form_type"/>
                <field name="product"/>
                <field name="company"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'converted'" decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_website_request_form" model="ir.ui.view">
        <field name="name">website.request.form</field>
        <field name="model">website.request</field>
        <field name="arch" type="xml">
            <form string="Website Request">
                <header>
                    <button name="action_convert_to_quotation" string="Convert to Quotation" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,converted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not sale_order_id">
                            <field name="sale_order_id" widget="statinfo" string="Quotation"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="company"/>
                            <field name="form_type"/>
                        </group>
                        <group>
                            <field name="product"/>
                            <field name="quantity"/>
                            <field name="country"/>
                            <field name="port"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_website_request_search" model="ir.ui.view">
        <field name="name">website.request.search</field>
        <field name="model">website.request</field>
        <field name="arch" type="xml">
            <search string="Website Requests">
                <field name="name"/>
                <field name="email"/>
                <field name="company"/>
                <field name="product"/>
                <filter string="Quote Requests" name="filter_quote" domain="[('form_type', '=', 'quote')]"/>
                <filter string="Contact Messages" name="filter_contact" domain="[('form_type', '=', 'contact')]"/>
                <separator/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Converted to Quotation" name="filter_converted" domain="[('state', '=', 'converted')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Form Type" name="group_by_form_type" context="{'group_by': 'form_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_website_request" model="ir.actions.act_window">
        <field name="name">Website Requests</field>
        <field name="res_model">website.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_website_request"
        name="Website Request"
        parent="sale.sale_menu_root"
        action="action_website_request"
        groups="sales_team.group_sale_salesman"
        sequence="25"/>
</odoo>
